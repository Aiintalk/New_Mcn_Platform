DATABASE_URL=postgresql+asyncpg://postgres:admin123@localhost:5432/mcn_m1
JWT_SECRET=change-me-in-production
JWT_EXPIRE_HOURS=24
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=Admin@123456
ENCRYPTION_KEY=change-me-32-chars-encryption-key
# CORS 允许的前端源（逗号分隔；生产环境改为实际域名，如 https://mcn.example.com）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 外部只读 KOL API 密钥；配置后通过请求头 X-API-Key 访问 /api/external/kols
EXTERNAL_KOLS_API_KEY=

# ─── AI 服务（默认值，可被 DB service_credentials 覆盖）───
LLM_API_BASE=https://yunwu.ai/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=claude-haiku-4-5-20251001

# ─── TikHub 服务（可被 DB service_credentials 覆盖）──────
TIKHUB_API_KEY=your_tikhub_api_key_here
TIKHUB_BASE_URL=https://api.tikhub.io

# ─── 内容分析智能体（固定输入表与部署级运行配置）──────
# 凭据只在部署环境填写，不提交真实值；报告根目录由任务配置信封传入。
CONTENT_ANALYSIS_FEISHU_APP_ID=
CONTENT_ANALYSIS_FEISHU_APP_SECRET=
CONTENT_ANALYSIS_FEISHU_CONTENT_APP_TOKEN=
CONTENT_ANALYSIS_FEISHU_CONTENT_TABLE_ID=
CONTENT_ANALYSIS_FEISHU_RELATION_APP_TOKEN=
CONTENT_ANALYSIS_FEISHU_RELATION_TABLE_ID=
CONTENT_ANALYSIS_MODEL_ID=
CONTENT_ANALYSIS_MODEL_PROVIDER=yunwu
CONTENT_ANALYSIS_SYSTEM_USER_ID=
CONTENT_ANALYSIS_SCHEDULER_ENABLED=false

# ─── 阿里云 OSS（凭证就绪后填写）────────────────────────
# OSS_ACCESS_KEY_ID=your_access_key_id
# OSS_ACCESS_KEY_SECRET=your_access_key_secret
# OSS_BUCKET=your-bucket-name
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# OSS_REGION=cn-hangzhou
